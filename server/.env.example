# Copy this to .env (or set these directly in your hosting platform's
# environment variable settings) before deploying anywhere real.

# Port the server listens on. Most hosting platforms (Render, Fly, Railway)
# set this for you automatically — don't hardcode it.
PORT=3000

# development | production. Controls whether missing ALLOWED_ORIGINS is a
# silent dev convenience or a logged warning.
NODE_ENV=production

# REQUIRED. A Postgres connection string. Every player, battle, avatar,
# friend, and season lives here now — this is what makes data survive a
# redeploy, a crash, or a free-tier spin-down, none of which a local file
# on the app server's own disk can promise.
#
# Local dev: `docker compose up` already provides one — see docker-compose.yml,
# no setup needed.
# Production, free: create a free database at https://neon.tech or
# https://supabase.com and paste its connection string here. Both work
# fine with a hobby app at this scale and persist independently of
# whatever's happening to your app server.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Comma-separated list of origins allowed to open a WebSocket connection,
# e.g. https://voicemog.example.com,https://www.voicemog.example.com
# Leaving this empty accepts connections from ANY origin — fine for local
# testing, a real gap in production (anyone could embed your battle logic
# on their own page and hit your server).
ALLOWED_ORIGINS=
